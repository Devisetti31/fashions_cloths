# ES ETHNIC STYLES - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.

# Application Settings
APP_NAME="ES ETHNIC STYLES"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Settings
HOST="127.0.0.1"
PORT=8000

# Database Settings
# By default, uses a project-local SQLite database
DATABASE_URL="sqlite:///./es_ethnic_styles.db"

# CORS Configuration (JSON array or comma-separated string)
# Allowed origins for frontend local development
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
